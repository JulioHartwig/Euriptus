# Banco de dados PostgreSQL (Neon em produção)
# DATABASE_URL: usada pelo app em runtime (no Neon, prefira a URL com "-pooler")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/euriptus?schema=public"
# DIRECT_URL: usada por migrations e introspecção (URL direta, sem pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/euriptus?schema=public"

# NextAuth
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# Opcional: exibe as credenciais de demonstração na tela de login.
# Em desenvolvimento elas já aparecem por padrão.
# SHOW_DEMO_CREDENTIALS="true"

# Opcional: senha usada pelo seed para todas as contas de demonstração.
# Em desenvolvimento o padrão é "senha123". Em produção use uma senha forte.
# SEED_PASSWORD="troque-esta-senha"
